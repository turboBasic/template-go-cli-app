{
  "config": {
    "default": true,
    "MD013": false,
    "MD060": {
      "style": "aligned"
    }
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "dist/**",
    "tmp/**",
    "LICENSE"
  ],
  "overrides": [
    {
      "filter": [
        ".github/PULL_REQUEST_TEMPLATE.md"
      ],
      "config": {
        "MD041": false
      },
      "combine": "merge"
    }
  ]
}
